function parseCSV(t,d){const r=[];let row=[],fl='',q=false;for(let i=0;i<t.length;i++){const c=t[i];if(q){if(c=='"'){if(t[i+1]=='"'){fl+='"';i++}else q=false}else fl+=c}else if(c=='"')q=true;else if(c==d){row.push(fl);fl=''}else if(c=='\n'||c=='\r'){if(c=='\r'&&t[i+1]=='\n')i++;row.push(fl);r.push(row);row=[];fl=''}else fl+=c}if(fl!==''||row.length){row.push(fl);r.push(row)}return r.filter(x=>x.some(v=>v.trim()!==''))}
