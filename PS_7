const SENS=/(^|_|\b)(email|phone|mobile|ssn|aadhaar|pan|dob|birth|address|salary|name|passport|card)(\b|_|$)/i;
const mk=(id,cat,title,sev,conf,ev,why,q,rec)=>({id,cat,title,sev,conf,ev,why,q,rec,score:Math.round(sev*conf*20),st:'open'});
