let PREV=null,LAST=null,PIDS=null,DIFF=null;
function ready(a){return Math.max(0,100-a.filter(x=>x.st!='dismissed').reduce((s,x)=>s+({5:12,4:7,3:3,2:1})[lvl(x.score)],0))}
