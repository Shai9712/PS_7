 H.forEach((h,c)=>{
  const v=B.map(r=>(r[c]??'').trim()),ne=v.filter(x=>!MISS.test(x)),m=n-ne.length,pct=m/n*100,num=ne.filter(x=>x!==''&&!isNaN(+x));
  if(pct>=5)miss.push({ln:'col',txt:'“'+h+'”: '+pct.toFixed(0)+'% missing ('+m+'/'+n+'), first at row '+(v.findIndex(x=>MISS.test(x))+2),p:pct});
  const isN=ne.length&&num.length/ne.length>=.9;
  if(ne.length&&!isN&&num.length/ne.length>.1)oth.push(mk('mix-'+h,'Data','Mixed types in “'+h+'”',3,.9,[{ln:'col',txt:Math.round(num.length/ne.length*100)+'% numeric, rest text'}],'Mixed types usually mean entry errors or undocumented codes.','Do text values encode something such as “unknown”?','Define allowed values and clean or map the exceptions.'));
  if(isN&&num.length>=8){const s=num.map(Number).sort((a,b)=>a-b),q1=s[s.length>>2],q3=s[(s.length*3)>>2],i=q3-q1,o=s.filter(x=>x<q1-3*i||x>q3+3*i);
   if(i>0&&o.length)oth.push(mk('out-'+h,'Data','Extreme outliers in “'+h+'”',3,.85,[{ln:'col',txt:o.length+' value(s) far outside the typical range, e.g. '+o.slice(0,3).join(', ')}],'Outliers can be errors, unit mix-ups or the most important cases.','Are these genuine or entry errors?','Inspect them manually and set a validation rule.'));
   if(/age|price|qty|quantity|amount|count|salary/i.test(h)&&s[0]<0)oth.push(mk('neg-'+h,'Data','Impossible negative values in “'+h+'”',4,1,[{ln:'col',txt:'minimum is '+s[0]}],'Negative values where none should exist point to upstream errors or refunds mixed with sales.','Are negatives refunds, corrections or bugs?','Separate or fix them and add a range check.'))}
  if(/(^|_)id$/i.test(h)&&ne.length&&new Set(ne).size<ne.length)oth.push(mk('id-'+h,'Data','Identifier “'+h+'” is not unique',5,1,[{ln:'col',txt:(ne.length-new Set(ne).size)+' repeated values'}],'Non-unique keys break joins and silently double-count.','Is this really the entity key?','Establish and enforce a unique key.'));
