 h+=vis.length?vis.map(x=>{const l=lvl(x.score);return '<details data-id="'+esc(x.id)+'" class="l'+l+(x.st=='dismissed'?' done':'')+'"><summary><span class="sc t'+l+'">'+LN[l]+' · '+x.score+'</span><span class="mt t'+l+'">'+'<i class="on"></i>'.repeat(l-1)+'<i></i>'.repeat(5-l)+'</span><span class="t">'+esc(x.title)+'</span><span class="mu">'+x.cat+(x.st!='open'?' · '+x.st:'')+'</span></summary><div class="bd"><h4>Evidence</h4>'+x.ev.map(e=>'<div class="ev" data-ln="'+(typeof e.ln=='number'?e.ln:'')+'" title="'+(typeof e.ln=='number'?'Click to jump to this line':'')+'"><i>'+(typeof e.ln=='number'?'L'+e.ln:esc(e.ln))+'</i>'+esc(e.txt.slice(0,220))+'</div>').join('')+(x.ev.length?'':'<p class="mu">No supporting text; this is an absence finding.</p>')+'<h4>Why it matters</h4><p>'+esc(x.why)+'</p><h4>Question to ask</h4><p>'+esc(x.q)+'</p><h4>Recommendation</h4><p>'+esc(x.rec)+'</p><h4>Basis for score</h4><p class="mu">Severity '+x.sev+'/5 × confidence '+Math.round(x.conf*100)+'%'+(x.conf<.7?' (absence-based, so lower confidence)':'')+'</p><div class="row"><button data-s="confirmed" data-i="'+esc(x.id)+'">Confirm gap</button><button data-s="dismissed" data-i="'+esc(x.id)+'">Dismiss</button><button data-s="open" data-i="'+esc(x.id)+'">Reset</button></div></div></details>'}).join(''):'<div class="empty">No findings in this view.</div>';
